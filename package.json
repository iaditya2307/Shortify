{
  "name": "shortify",
  "version": "1.0.0",
  "description": "URL Shortener with Supabase database integration and FastAPI backend",
  "main": "app/main.py",
  "scripts": {
    "start": "python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "dev": "python3 -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "test": "python3 -m unittest discover -s tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iaditya2307/Shortify.git"
  },
  "keywords": [
    "url-shortener",
    "fastapi",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0"
  }
}
